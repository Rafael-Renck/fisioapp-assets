# Copie a string de conexão PostgreSQL do painel Supabase > Connect.
# Configure esta variável apenas no servidor. Nunca use NEXT_PUBLIC_ nem faça commit da senha.
# SUPABASE_DATABASE_URL=postgresql://usuario:senha@host:5432/postgres
# SUPABASE_DB_CA_FILE=.data/supabase-ca.crt
# Na Vercel, use o certificado em base64 em vez de um caminho de arquivo.
# SUPABASE_DB_CA_BASE64=base64_do_certificado

# Login opcional com Google. Configure apenas no servidor.
# GOOGLE_CLIENT_ID=id_do_cliente_oauth.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=segredo_do_cliente_oauth
# GOOGLE_REDIRECT_URI=https://seu-dominio/api/auth/google/callback
